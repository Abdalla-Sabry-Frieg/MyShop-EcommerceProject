@model IEnumerable<CategoryProductsViewModel>

<style>
    /* Card hover animation */
    .card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .card:hover {
            transform: translateY(-10px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
        }

    /* Product image animation */
    .card-img-top {
        transition: transform 0.3s ease;
    }

    .card:hover .card-img-top {
        transform: scale(1.05);
    }
</style>
<header class="bg-dark py-5">
    <div class="container px-4 px-lg-5 my-5">
        <div class="text-center text-white">
            <h1 class="display-4 fw-bolder">Welcome to in Fekra's Book Shop !</h1>
            <p class="lead fw-normal text-white-50 mb-0">let's descover some Products</p>
        </div>
    </div>
</header>
<section class="py-5">
    <div class="container px-4 px-lg-5 mt-5">
        @foreach (var categoryProduct in Model)
        {
            <div class="category-section mb-5">
                <!-- Category Name -->
                <h2 class="my-4">@categoryProduct.Category.Name section</h2>

                <div class="row gx-4 gx-lg-5 row-cols-2 row-cols-md-3 row-cols-xl-4 justify-content-center rounded-3" style="background-color:#eaf1f1;">
                    @foreach (var product in categoryProduct.Products)
                    {
                        <div class="col mb-5 mt-5" >
                            <div class="card h-100">
                                <!-- Product image-->
                                <a href="/Customer/Home/Details/@product.Id">
                                    <img class="card-img-top" src="~/@product.Image" width="450px" height="300px" alt="@product.Name" />
                                </a>
                                <!-- Product details-->
                                <div class="card-body p-4">
                                    <div class="text-center">
                                        <!-- Product name-->
                                        <h5 class="fw-bolder">@product.Name</h5>
                                        <!-- Product price-->
                                        @product.Price.ToString("C")
                                    </div>
                                </div>
                                <!-- Product actions-->
                                <div class="card-footer p-4 pt-0 border-top-0 bg-transparent">
                                    <div class="text-center">
                                        <a class="btn btn-outline-dark mt-auto" href="/Customer/Home/Details/@product.Id">
                                            Product Details
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                   
                </div>
                <div class="row gx-4 gx-lg-5 row-cols-2 row-cols-md-3 row-cols-xl-4 justify-content-center rounded-3" style="background-color:#eaf1f1;">
                    <div class="card-footer p-4 pt-0 border-top-0 bg-transparent ">
                        <div class="text-center">
                            <a class="btn btn-outline-dark mt-auto" href="/Customer/Home/allProducts/@categoryProduct.Category.Id">
                                view all products
                            </a>
                        </div>
                    </div>
                </div>

               
            </div>
            
        }
    </div>
</section>

