@model ShoppingCart

<form asp-action="Details" method="post" enctype="multipart/form-data">
    <section class="py-5">
        <div class="container px-4 px-lg-5 my-5">
            <div class="row gx-4 gx-lg-5 align-items-center">
                <input asp-for="@Model.ProductId" hidden />

                <!-- Product Image -->
                <div class="col-12 col-md-6 mb-4 mb-md-0">
                    <img src="~/@Model.Product.Image" class="img-fluid" alt="@Model.Product.Name" />
                </div>

                <!-- Product Details -->
                <div class="col-12 col-md-6">
                    <div class="mb-2">Category: @Model.Product.Category.Name</div>
                    <h1 class="fw-bolder">@Model.Product.Name</h1>
                    <div class="mb-3">
                        <span>@Model.Product.Price.ToString("C")</span>
                    </div>
                    <p class="lead">@Model.Product.Description</p>

                    <!-- Quantity and Add to Cart Button -->
                    <div class="d-flex flex-column flex-sm-row align-items-center py-4">
                       
                        <button class="btn btn-outline-dark flex-shrink-0" type="submit">
                            <i class="bi-cart-fill me-1"></i>
                            Add to cart
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>
